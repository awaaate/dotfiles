# ═══════════════════════════════════════════════════════════════════════════
# GHOSTTY CONFIGURATION
# Theme: Catppuccin Macchiato (matches Sketchybar)
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# FONT
# ───────────────────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thicken = true
adjust-cell-height = 10%

# Ligatures
font-feature = calt
font-feature = liga

# ───────────────────────────────────────────────────────────────────────────
# WINDOW
# ───────────────────────────────────────────────────────────────────────────
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-decoration = true
macos-titlebar-style = hidden
window-save-state = always
confirm-close-surface = false

# Blur & transparency (subtle)
background-opacity = 1.0
background-blur-radius = 0

# ───────────────────────────────────────────────────────────────────────────
# CURSOR
# ───────────────────────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
shell-integration-features = cursor,sudo,title

# Acento coral rosa-naranja (#FF7A6B)
cursor-color = ff7a6b
cursor-text = 1f1f28
selection-background = ff7a6b
selection-foreground = 1f1f28

# ───────────────────────────────────────────────────────────────────────────
# SCROLLBACK
# ───────────────────────────────────────────────────────────────────────────
scrollback-limit = 20000

# ───────────────────────────────────────────────────────────────────────────
# CLIPBOARD
# ───────────────────────────────────────────────────────────────────────────
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false
copy-on-select = clipboard

# ───────────────────────────────────────────────────────────────────────────
# MOUSE
# ───────────────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true
focus-follows-mouse = false

# ───────────────────────────────────────────────────────────────────────────
# THEME (matches p10k Pure style)
# ───────────────────────────────────────────────────────────────────────────
theme = Kanagawa Wave

# ───────────────────────────────────────────────────────────────────────────
# KEYBINDINGS (minimal - tmux handles multiplexing)
# ───────────────────────────────────────────────────────────────────────────

# Unbind Ghostty's ctrl+a leader (pass through to tmux prefix)
# Binding ctrl+a directly unbinds ALL ctrl+a>* sequences and
# passes the key through to the terminal child process (tmux)
keybind = ctrl+a=unbind

# Config management
keybind = super+shift+comma=open_config
keybind = super+shift+r=reload_config

# Font size
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+0=reset_font_size

# Clear
keybind = super+k=clear_screen

# Quick commands (sent to tmux/shell)
keybind = super+shift+g=text:lazygit\n
keybind = super+shift+f=text:yazi\n
keybind = super+shift+h=text:btop\n
