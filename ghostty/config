# ═══════════════════════════════════════════════════════════════════════════
# GHOSTTY — Ember
# Verified against Ghostty 1.3.1. Colours live in themes/ember (generated).
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# THEME
# ───────────────────────────────────────────────────────────────────────────
# themes/ember is generated by tools/build.mjs. Nothing below overrides a
# colour: the previous config set cursor-color and selection-background inline,
# which silently beat the theme and made the real palette impossible to read
# off the file.
theme = azur

# ───────────────────────────────────────────────────────────────────────────
# FONT
# ───────────────────────────────────────────────────────────────────────────
# Kept after evaluation, not by default. Alternatives considered (Berkeley
# Mono, IosevkaTerm, Monaspace, CommitMono, Maple Mono) are all ABSENT from
# this machine, so any switch means adding a dependency. JetBrains Mono earns
# the slot regardless: tall x-height at 14px, unambiguous 0/O and 1/l/I, and
# complete Nerd Font coverage for the glyphs sketchybar, lazygit and the pi
# TUI all rely on. Revisit only if a font is actually installed to compare.
font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thicken = true

# 10% extra leading. Terminal UIs pack lines tightly; this is the single
# highest-leverage readability setting for long sessions.
adjust-cell-height = 10%

font-feature = calt
font-feature = liga

# ───────────────────────────────────────────────────────────────────────────
# WINDOW
# ───────────────────────────────────────────────────────────────────────────
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-padding-color = background
window-decoration = true
macos-titlebar-style = hidden
window-save-state = always
confirm-close-surface = false

# Opaque, deliberately. Transparency and blur were evaluated and rejected for
# the terminal: both reduce text contrast against whatever happens to be
# behind the window, cost GPU time on every frame, and make code review
# harder. Translucency is used only in sketchybar, where the content is
# decorative rather than read. No background-image for the same reasons.
background-opacity = 1.0
background-blur = false

# ───────────────────────────────────────────────────────────────────────────
# SPLITS — level 2 of the focus hierarchy (window ring → split → nvim)
# ───────────────────────────────────────────────────────────────────────────
# The unfocused split recedes by dimming its CONTENT rather than by drawing a
# second bright border. Only one accent-coloured ring is ever on screen.
unfocused-split-opacity = 0.82
unfocused-split-fill = #0f0907
split-divider-color = #433935

# ───────────────────────────────────────────────────────────────────────────
# CURSOR
# ───────────────────────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
shell-integration-features = cursor,sudo,title

# ───────────────────────────────────────────────────────────────────────────
# KEYBOARD
# ───────────────────────────────────────────────────────────────────────────
# On macOS, Option+letter types a special character (˜ ç œ …) instead of
# sending Alt. Unset by default, which silently breaks every alt-based binding
# in a TUI — pi's alt+n/t/k/r for new/tree/fork/resume among them.
#
# `left`, not `true`, on purpose: only the LEFT Option becomes Alt. The right
# one keeps composing accents, so á é í ó ú ñ still work.
macos-option-as-alt = left

# ───────────────────────────────────────────────────────────────────────────
# SCROLLBACK
# ───────────────────────────────────────────────────────────────────────────
scrollback-limit = 20000

# ───────────────────────────────────────────────────────────────────────────
# CLIPBOARD
# ───────────────────────────────────────────────────────────────────────────
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false
copy-on-select = clipboard

# ───────────────────────────────────────────────────────────────────────────
# MOUSE
# ───────────────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true
focus-follows-mouse = false

# ───────────────────────────────────────────────────────────────────────────
# KEYBINDINGS (minimal — tmux/cmux handle multiplexing)
# ───────────────────────────────────────────────────────────────────────────

# Pass ctrl+a through to the tmux prefix. Binding it directly unbinds every
# ctrl+a>* sequence, which is what we want.
keybind = ctrl+a=unbind

# BEHAVIOUR CHANGE — these three defaults are released back to the terminal
# because they are swallowed before nvim and tmux can see them:
#   ctrl+tab / ctrl+shift+tab  → nvim buffer and tmux window cycling
#   shift+up / shift+down      → shift-select in nvim and in readline
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = shift+up=unbind
keybind = shift+down=unbind

# Config management.
# NOTE: `super+shift+comma` does NOT replace Ghostty's built-in
# `super+shift+,`=reload_config — both triggers persist in 1.3.1. Open-config
# is bound to super+shift+period instead so the two cannot shadow each other.
keybind = super+shift+period=open_config
keybind = super+shift+r=reload_config

# Font size
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+0=reset_font_size

# Clear
keybind = super+k=clear_screen

# Quick commands (sent to the shell)
keybind = super+shift+g=text:lazygit\n
keybind = super+shift+f=text:yazi\n
keybind = super+shift+h=text:btop\n

# ───────────────────────────────────────────────────────────────────────────
# RESCATADO de ~/Library/Application Support/com.mitchellh.ghostty/config
# ───────────────────────────────────────────────────────────────────────────
# En macOS Ghostty carga ESE archivo además de este, y lo carga después, así
# que ganaba: forzaba theme = Dracula, font-family = JetBrains Mono (sin Nerd)
# y macos-option-as-alt = false, anulando el rediseño entero sin dar ningún
# error. Se movió al backup. Lo que sigue es lo suyo que no colisiona.

shell-integration = zsh
window-colorspace = display-p3
window-height = 36
window-width = 120

# Navegación por palabra y línea en la shell.
keybind = opt+left=text:\x1bb
keybind = opt+right=text:\x1bf
keybind = opt+backspace=text:\x17
keybind = cmd+left=csi:H
keybind = cmd+right=csi:F
keybind = cmd+backspace=text:\x15

# Terminal desplegable con hotkey global.
keybind = global:ctrl+grave_accent=toggle_quick_terminal

keybind = ctrl+n=new_window
keybind = shift+enter=text:\n

# Icono personalizado.
macos-icon = xray
macos-icon-ghost-color = #ff0566
macos-icon-screen-color = #0566ff
