{
  "theme": "azur",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "xhigh",

  "quietStartup": true,
  "externalEditor": "nvim",
  "editorPaddingX": 1,
  "outputPad": 1,
  "autocompleteMaxVisible": 12,
  "doubleEscapeAction": "tree",

  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.4-mini"
  ],

  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 24000
  },

  "retry": {
    "enabled": true,
    "maxRetries": 4,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0
    }
  },

  "terminal": {
    "showImages": true,
    "imageWidthCells": 72
  },

  "prompts": ["prompts"]
}
