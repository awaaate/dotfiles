{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Hyper Key + Double tap Escape",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "name": "caps_lock_tapped",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    { "key_code": "escape" }
                                ],
                                "to_after_key_up": [
                                    { "set_variable": { "name": "caps_lock_tapped", "value": 0 } }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    { "set_variable": { "name": "caps_lock_tapped", "value": 1 } },
                                    {
                                        "key_code": "left_control",
                                        "modifiers": ["left_command", "left_option"]
                                    }
                                ],
                                "to_delayed_action": {
                                    "to_if_invoked": [
                                        { "set_variable": { "name": "caps_lock_tapped", "value": 0 } }
                                    ],
                                    "to_if_canceled": [
                                        { "set_variable": { "name": "caps_lock_tapped", "value": 0 } }
                                    ]
                                },
                                "parameters": {
                                    "basic.to_delayed_action_delay_milliseconds": 250
                                },
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Hyper+Tab → Ctrl+Tab (cambio de pestañas)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "tab",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "tab",
                                        "modifiers": ["left_control"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Hyper+Shift+Tab → Ctrl+Shift+Tab (pestaña anterior)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "tab",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option", "shift"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "tab",
                                        "modifiers": ["left_control", "shift"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Hyper shortcuts → Cmd shortcuts (a,c,v,x,z,s,w)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "a",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option"]
                                    }
                                },
                                "to": [{ "key_code": "a", "modifiers": ["left_command"] }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "c",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option"]
                                    }
                                },
                                "to": [{ "key_code": "c", "modifiers": ["left_command"] }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "v",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option"]
                                    }
                                },
                                "to": [{ "key_code": "v", "modifiers": ["left_command"] }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "x",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option"]
                                    }
                                },
                                "to": [{ "key_code": "x", "modifiers": ["left_command"] }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "z",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option"]
                                    }
                                },
                                "to": [{ "key_code": "z", "modifiers": ["left_command"] }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "s",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option"]
                                    }
                                },
                                "to": [{ "key_code": "s", "modifiers": ["left_command"] }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "w",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option"]
                                    }
                                },
                                "to": [{ "key_code": "w", "modifiers": ["left_command"] }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Vim Mode: Hyper+Enter → activa vim_mode",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "return_or_enter",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option"]
                                    }
                                },
                                "to": [
                                    { "set_variable": { "name": "vim_mode", "value": 1 } }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Vim Mode: Escape → desactiva vim_mode",
                        "manipulators": [
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": {
                                    "key_code": "escape"
                                },
                                "to": [
                                    { "set_variable": { "name": "vim_mode", "value": 0 } }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Vim Mode: hjkl → arrows",
                        "manipulators": [
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": {
                                    "key_code": "h",
                                    "modifiers": { "optional": ["shift"] }
                                },
                                "to": [{ "key_code": "left_arrow" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": {
                                    "key_code": "j",
                                    "modifiers": { "optional": ["shift"] }
                                },
                                "to": [{ "key_code": "down_arrow" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": {
                                    "key_code": "k",
                                    "modifiers": { "optional": ["shift"] }
                                },
                                "to": [{ "key_code": "up_arrow" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": {
                                    "key_code": "l",
                                    "modifiers": { "optional": ["shift"] }
                                },
                                "to": [{ "key_code": "right_arrow" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Vim Mode: w/b → word navigation",
                        "manipulators": [
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": {
                                    "key_code": "w",
                                    "modifiers": { "optional": ["shift"] }
                                },
                                "to": [{ "key_code": "right_arrow", "modifiers": ["left_option"] }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": {
                                    "key_code": "b",
                                    "modifiers": { "optional": ["shift"] }
                                },
                                "to": [{ "key_code": "left_arrow", "modifiers": ["left_option"] }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Vim Mode: 0/$ → line start/end",
                        "manipulators": [
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": {
                                    "key_code": "0",
                                    "modifiers": { "optional": ["shift"] }
                                },
                                "to": [{ "key_code": "left_arrow", "modifiers": ["left_command"] }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": {
                                    "key_code": "4",
                                    "modifiers": { "mandatory": ["shift"] }
                                },
                                "to": [{ "key_code": "right_arrow", "modifiers": ["left_command"] }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Vim Mode: G → fin documento",
                        "manipulators": [
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": {
                                    "key_code": "g",
                                    "modifiers": { "mandatory": ["shift"] }
                                },
                                "to": [{ "key_code": "down_arrow", "modifiers": ["left_command"] }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Vim Mode: u → undo, Ctrl+r → redo",
                        "manipulators": [
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": { "key_code": "u" },
                                "to": [{ "key_code": "z", "modifiers": ["left_command"] }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": {
                                    "key_code": "r",
                                    "modifiers": { "mandatory": ["control"] }
                                },
                                "to": [{ "key_code": "z", "modifiers": ["left_command", "shift"] }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Vim Mode: x → delete char",
                        "manipulators": [
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": { "key_code": "x" },
                                "to": [{ "key_code": "delete_forward" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Vim Mode: i → insert mode (exit vim mode)",
                        "manipulators": [
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": { "key_code": "i" },
                                "to": [
                                    { "set_variable": { "name": "vim_mode", "value": 0 } }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Hyper+R → Ctrl+R (atuin history search)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "r",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "r",
                                        "modifiers": ["left_control"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Vim Mode: a → append (exit vim mode, move right)",
                        "manipulators": [
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": { "key_code": "a" },
                                "to": [
                                    { "key_code": "right_arrow" },
                                    { "set_variable": { "name": "vim_mode", "value": 0 } }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Vim Mode: o/O → new line",
                        "manipulators": [
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": { "key_code": "o" },
                                "to": [
                                    { "key_code": "right_arrow", "modifiers": ["left_command"] },
                                    { "key_code": "return_or_enter" },
                                    { "set_variable": { "name": "vim_mode", "value": 0 } }
                                ],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    { "name": "vim_mode", "type": "variable_if", "value": 1 }
                                ],
                                "from": { 
                                    "key_code": "o",
                                    "modifiers": { "mandatory": ["shift"] }
                                },
                                "to": [
