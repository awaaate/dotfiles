# ═══════════════════════════════════════════════════════════════════════════
# GHOSTTY CONFIGURATION
# Theme: Catppuccin Macchiato (matches Sketchybar)
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# FONT
# ───────────────────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thicken = true
adjust-cell-height = 10%

# Ligatures
font-feature = calt
font-feature = liga

# ───────────────────────────────────────────────────────────────────────────
# WINDOW
# ───────────────────────────────────────────────────────────────────────────
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-decoration = true
macos-titlebar-style = hidden
window-save-state = always
confirm-close-surface = false

# Blur & transparency (subtle)
background-opacity = 0.95
background-blur-radius = 20

# ───────────────────────────────────────────────────────────────────────────
# CURSOR
# ───────────────────────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
shell-integration-features = cursor,sudo,title

# ───────────────────────────────────────────────────────────────────────────
# SCROLLBACK
# ───────────────────────────────────────────────────────────────────────────
scrollback-limit = 100000

# ───────────────────────────────────────────────────────────────────────────
# CLIPBOARD
# ───────────────────────────────────────────────────────────────────────────
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false
copy-on-select = clipboard

# ───────────────────────────────────────────────────────────────────────────
# MOUSE
# ───────────────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true
focus-follows-mouse = true

# ───────────────────────────────────────────────────────────────────────────
# THEME (matches p10k Pure style)
# ───────────────────────────────────────────────────────────────────────────
theme = Kanagawa Wave

# ───────────────────────────────────────────────────────────────────────────
# KEYBINDINGS
# ───────────────────────────────────────────────────────────────────────────

# Quick actions
keybind = super+shift+comma=open_config
keybind = super+shift+r=reload_config

# Tabs
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+shift+left_bracket=previous_tab
keybind = super+shift+right_bracket=next_tab
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5

# Splits
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+alt+h=goto_split:left
keybind = super+alt+j=goto_split:bottom
keybind = super+alt+k=goto_split:top
keybind = super+alt+l=goto_split:right
keybind = super+shift+enter=toggle_split_zoom

# Resize splits
keybind = super+alt+shift+h=resize_split:left,50
keybind = super+alt+shift+l=resize_split:right,50
keybind = super+alt+shift+k=resize_split:up,50
keybind = super+alt+shift+j=resize_split:down,50
keybind = super+alt+equal=equalize_splits

# Font size
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+0=reset_font_size

# Scrolling
keybind = super+up=scroll_page_up
keybind = super+down=scroll_page_down
keybind = super+home=scroll_to_top
keybind = super+end=scroll_to_bottom

# Search
keybind = super+f=text:search

# Clear
keybind = super+k=clear_screen
keybind = super+l=write_screen_file:open

# Quick commands
keybind = super+shift+g=text:lazygit\n
keybind = super+shift+f=text:yazi\n
keybind = super+shift+h=text:btop\n
